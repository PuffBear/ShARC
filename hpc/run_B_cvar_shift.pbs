#!/bin/bash
#PBS -N sharc_cvar_shift
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=16:00:00
#PBS -o logs/run_B_cvar_shift.out
#PBS -e logs/run_B_cvar_shift.err
# Project code (-P) is passed by submit_pair.sh; set PROJECT= there.
# User: agriya.yadav_ug2023  Host: 10.1.4.95 (ssh sharc)

# ── Run B: CVaR-REINFORCE + shift (proposed method) ───────────────────────
# CVaR-REINFORCE (alpha=0.1), shift augmentation ON, d_shift=8.
# Identical config to Run A — only use_cvar differs.
# Checkpoint: experiments/results/cvar_shift/best.pt

set -euo pipefail
cd "$PBS_O_WORKDIR"

mkdir -p logs

source ShARCvenv/bin/activate

echo "[$(date)] Node: $(hostname)  CPUs: $(nproc)"
echo "[$(date)] Python: $(which python)  ($(python --version))"
echo "[$(date)] Training cvar_shift  (CVaR-REINFORCE α=0.1 + curriculum shift, d_shift=8)"

python -m training.train \
    --data_dir         data/test_dataset \
    --use_shift        True \
    --use_cvar         True \
    --alpha            0.1 \
    --shift_mode       curriculum \
    --shift_warmup     1000 \
    --max_demand_shift 0.3 \
    --max_cost_shift   0.3 \
    --min_availability 0.7 \
    --n_epochs         200 \
    --batch_size       32 \
    --lr               1e-4 \
    --seed             42 \
    --device           cpu \
    --run_name         cvar_shift

echo "[$(date)] Done → experiments/results/cvar_shift/best.pt"
